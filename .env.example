# ---------------------------------------------------------------------------
# Wolf Clan — copy to .env.local and fill in. Never commit real secrets.
# Public values are shipped to the browser; everything else stays on the server.
# ---------------------------------------------------------------------------

# Public (safe in the browser)
NEXT_PUBLIC_SITE_URL=https://your-domain
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-host
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_APP_VERSION=1.0.0

# Database (this deployment)
DATABASE_URL=postgresql://user:password@host:5432/database

# Server-only secrets (set in Vercel / Supabase secrets only)
SUPABASE_SERVICE_ROLE_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tkofficial68@gmail.com
RESEND_API_KEY=
EMAIL_FROM="Wolf Clan <no-reply@your-domain>"
DEVELOPER_CONTACT_EMAIL=tkofficial68@gmail.com
OWNER_CONTACT_EMAIL=mrshadow12301@gmail.com
CLEANUP_WORKER_SECRET=
PUSH_WEBHOOK_SECRET=
CRON_SECRET=

# Optional limits
MAX_UPLOAD_MB=50
APP_URL=http://localhost:3000

# Owner bootstrap only (scripts/seed-owner.mjs, scripts/seed-part2.mjs)
OWNER_EMAIL=
OWNER_PASSWORD=
